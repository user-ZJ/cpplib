# Kaldi uses the LP64 CBLAS/LAPACK ABI (32-bit BLAS integers).
set(KALDI_BLAS_BACKEND AUTO CACHE STRING "Kaldi BLAS backend: AUTO, OPENBLAS or MKL")
set_property(CACHE KALDI_BLAS_BACKEND PROPERTY STRINGS AUTO OPENBLAS MKL)
string(TOUPPER "${KALDI_BLAS_BACKEND}" backend)
if(NOT backend MATCHES "^(AUTO|OPENBLAS|MKL)$")
    message(FATAL_ERROR "Invalid KALDI_BLAS_BACKEND=${KALDI_BLAS_BACKEND}")
endif()
if(backend STREQUAL "AUTO")
    if(APPLE)
        set(backend OPENBLAS)
    else()
        set(backend MKL)
    endif()
endif()
set(KALDI_BLAS_FOUND FALSE)
if(backend STREQUAL "OPENBLAS")
    find_path(OPENBLAS_INCLUDE_DIR openblas_config.h HINTS /opt/homebrew/opt/openblas /usr/local/opt/openblas PATH_SUFFIXES include include/openblas)
    find_path(OPENBLAS_LAPACKE_INCLUDE_DIR lapacke.h HINTS "${OPENBLAS_INCLUDE_DIR}" /opt/homebrew/opt/openblas /usr/local/opt/openblas PATH_SUFFIXES include include/openblas)
    find_library(OPENBLAS_LIBRARY openblas HINTS /opt/homebrew/opt/openblas /usr/local/opt/openblas PATH_SUFFIXES lib)
    if(OPENBLAS_INCLUDE_DIR AND OPENBLAS_LAPACKE_INCLUDE_DIR AND OPENBLAS_LIBRARY)
        include(CheckCXXSourceCompiles)
        function(check_openblas_lp64)
            set(CMAKE_REQUIRED_INCLUDES "${OPENBLAS_INCLUDE_DIR}" "${OPENBLAS_LAPACKE_INCLUDE_DIR}")
            set(CMAKE_REQUIRED_LIBRARIES "${OPENBLAS_LIBRARY}")
            check_cxx_source_compiles("#include <cblas.h>
#include <lapacke.h>
static_assert(sizeof(blasint) == sizeof(int), \"Kaldi requires LP64 OpenBLAS\");
int main() { double x=1; return cblas_ddot(1, &x, 1, &x, 1) != 1; }" OPENBLAS_LP64_WORKS)
            if(NOT OPENBLAS_LP64_WORKS)
                message(FATAL_ERROR "OpenBLAS LP64 header/link check failed; see CMakeError.log")
            endif()
        endfunction()
        check_openblas_lp64()
        add_library(kaldi_blas INTERFACE)
        target_compile_definitions(kaldi_blas INTERFACE HAVE_OPENBLAS)
        target_include_directories(kaldi_blas INTERFACE "${OPENBLAS_INCLUDE_DIR}" "${OPENBLAS_LAPACKE_INCLUDE_DIR}")
        target_link_libraries(kaldi_blas INTERFACE "${OPENBLAS_LIBRARY}")
        set(KALDI_BLAS_FOUND TRUE)
    endif()
else()
    find_path(MKL_INCLUDE_DIR mkl.h HINTS /opt/intel/mkl PATH_SUFFIXES include)
    foreach(component mkl_intel_lp64 mkl_core mkl_sequential)
        find_library(${component}_LIBRARY ${component} HINTS /opt/intel/mkl PATH_SUFFIXES lib lib/intel64)
    endforeach()
    if(MKL_INCLUDE_DIR AND mkl_intel_lp64_LIBRARY AND mkl_core_LIBRARY AND mkl_sequential_LIBRARY)
        add_library(kaldi_blas INTERFACE)
        target_compile_definitions(kaldi_blas INTERFACE HAVE_MKL)
        target_include_directories(kaldi_blas INTERFACE "${MKL_INCLUDE_DIR}")
        target_link_libraries(kaldi_blas INTERFACE "${mkl_intel_lp64_LIBRARY}" "${mkl_core_LIBRARY}" "${mkl_sequential_LIBRARY}")
        set(KALDI_BLAS_FOUND TRUE)
    endif()
endif()
if(KALDI_BLAS_FOUND)
    message(STATUS "Kaldi BLAS backend: ${backend}")
elseif(NOT KALDI_BLAS_BACKEND STREQUAL "AUTO")
    message(FATAL_ERROR "Requested Kaldi BLAS backend ${backend} not installed. See README.md.")
else()
    message(STATUS "Kaldi BLAS not found; skip Kaldi and VAD")
endif()
